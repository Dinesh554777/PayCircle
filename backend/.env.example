# Copy this file to backend/.env and fill in your own values.
# Never commit the real backend/.env file.

# Local native PostgreSQL (for development)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/PayCircle
# Docker PostgreSQL alternative (see docker-compose.yml)
# DATABASE_URL=postgresql://paycircle:paycircle@localhost:5433/paycircle

# ── Neon Production Database ─────────────────────────────────────────
# Pooled connection (app traffic): has -pooler in hostname
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/PayCircle?sslmode=require
# Direct connection (migrations): no -pooler in hostname
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/PayCircle?sslmode=require
SECRET_KEY=your-super-secret-key-here
JWT_SECRET=your-super-secret-key-here
AI_API_KEY=your-ai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
DEBUG=false
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAILS=admin@paycircle.dev

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Gmail SMTP (for invitation / verification / notification emails) ──
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-char app password below (keep the quotes for spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM=your-gmail@gmail.com

# ── Resend (HTTPS email API — REQUIRED on Render) ─────────────────────
# Render blocks outbound SMTP, so use Resend's HTTPS API instead there.
# Get a key at https://resend.com (free tier) and verify a sending domain/address.
# When RESEND_API_KEY is set, it takes precedence over SMTP.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=PayCircle <noreply@your-domain.com>
